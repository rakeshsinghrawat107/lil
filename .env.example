# Server Configuration
FLASK_ENV=development
PORT=5000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Supabase / PostgreSQL Database Configuration
# Option 1 (Recommended): Supabase Connection Pooler (Transaction Mode, Port 6543)
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Option 2: Direct Supabase Connection (Port 5432)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Local SQLite fallback:
DATABASE_URL=sqlite:///backend/cultural_committee.db

# Authentication & OTP Adapter Configuration
OTP_DELIVERY_MODE=development
OTP_EXPIRY_MINUTES=15
OTP_MAX_ATTEMPTS=5

# SMTP Configuration (only required if OTP_DELIVERY_MODE=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@tapmi.edu.in
SMTP_PASSWORD=placeholder_secret
SMTP_USE_TLS=true

# Pilot Event & Bootstrap Convener
PILOT_EVENT_NAME=Kala Fest
BOOTSTRAP_CONVENER_EMAIL=convener@tapmi.edu.in
BOOTSTRAP_CONVENER_PASSWORD=ConvenerPass2026!ddcdf461
SEED_DEMO_DATA=true
